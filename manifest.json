{
  "manifest_version": 3,
  "name": "NSR-Boost",
  "version": "1.0.0",
  "description": "AI-assisted form review for the BoostUSA (LossControl360) platform. Drives the DynForms engine directly rather than scraping the DOM.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "https://boostusa.losscontrol360.com/*",
    "*://*.losscontrol360.com/*",
    "https://qagent.dhaninfo.ai/*",
    "https://lms.dhaninfo.ai/*"
  ],

  "action": {
    "default_title": "Open NSR-Boost",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://boostusa.losscontrol360.com/*"],
      "js": ["page/dynforms-agent.js", "page/photos-agent.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://boostusa.losscontrol360.com/*"],
      "js": [
        "common/forms.js",
        "content/bridge.js",
        "content/generalinfo.js",
        "content/highlighter.js",
        "content/imageModal.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
